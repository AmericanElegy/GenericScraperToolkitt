{
  "name": "genericscrapertoolkitt",
  "version": "1.0.0",
  "description": "Standalone public HTML table extraction toolkit",
  "scripts": {
    "test": "node --test",
    "dev": "node scripts/dev.mjs",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run",
    "dev:wrangler": "wrangler dev --env local",
    "test:live": "node scripts/verify-live.mjs",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "predev": "npm run build",
    "pretest:live": "npm run build",
    "check:browser": "npm run build && node scripts/check-browser.mjs",
    "interpretation:demo": "node scripts/interpret.mjs demo",
    "interpretation": "node scripts/interpret.mjs",
    "check:lab-browser": "npm run build && node scripts/check-lab-browser.mjs",
    "release:check": "node scripts/release-check.mjs",
    "dev:browser": "node scripts/browser-render-server.mjs",
    "check:renderer-browser": "node scripts/check-renderer-browser.mjs",
    "check:source-browser": "npm run build && node scripts/check-source-browser.mjs",
    "test:live-sources": "npm run build && node scripts/check-live-sources.mjs",
    "feedback": "node scripts/feedback.mjs",
    "check:feedback-browser": "npm run build && node scripts/check-feedback-storage-browser.mjs",
    "check:workspace-browser": "npm run build && node scripts/check-workspace-browser.mjs",
    "test:live-workspace": "npm run build && node scripts/check-workspace-live.mjs",
    "check:prose-benchmark": "npm run build && node scripts/check-prose-benchmark.mjs",
    "precheck": "npm run build",
    "predeploy": "npm run build",
    "check:workbench-browser": "npm run build && node scripts/check-workbench-browser.mjs",
    "predev:wrangler": "npm run build",
    "benchmark:offline": "npm run build && node scripts/evaluate-extraction.mjs",
    "benchmark:live": "node scripts/check-live-benchmark.mjs",
    "benchmark:capture": "node scripts/capture-benchmark-sources.mjs",
    "benchmark:mixed": "npm run build && node scripts/evaluate-mixed-document.mjs",
    "benchmark:report": "node scripts/report-extraction-benchmark.mjs",
    "ai:compare": "npm run build && node scripts/compare-ai.mjs",
    "verify:source": "node scripts/verify-release-source.mjs",
    "check:market-browser": "npm run build && node scripts/check-market-browser.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmericanElegy/GenericScraperToolkitt.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AmericanElegy/GenericScraperToolkitt/issues"
  },
  "homepage": "https://github.com/AmericanElegy/GenericScraperToolkitt#readme",
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.1-beta",
    "wrangler": "4.151.3"
  },
  "private": true,
  "dependencies": {
    "entities": "8.1.0",
    "fflate": "0.8.3",
    "jose": "6.2.18",
    "mammoth": "1.13.0",
    "papaparse": "5.7.1",
    "pdfjs-dist": "6.5.438",
    "read-excel-file": "9.3.20"
  },
  "overrides": {
    "undici": "7.30.1"
  }
