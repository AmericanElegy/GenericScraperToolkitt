{
  "name": "genericscrapertoolkitt",
  "version": "1.0.0",
  "description": "Standalone public HTML table extraction toolkit",
  "scripts": {
    "test": "node --test",
    "dev": "node scripts/dev.mjs",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run",
    "dev:wrangler": "wrangler dev",
    "test:live": "node scripts/verify-live.mjs",
    "build": "esbuild src/worker.js --bundle --format=esm --platform=browser --loader:.txt=text --outfile=worker-code.txt",
    "pretest": "npm run build",
    "predev": "npm run build",
    "pretest:live": "npm run build",
    "check:browser": "npm run build && node scripts/check-browser.mjs",
    "interpretation:demo": "node scripts/interpret.mjs demo",
    "interpretation": "node scripts/interpret.mjs",
    "check:lab-browser": "npm run build && node scripts/check-lab-browser.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmericanElegy/GenericScraperToolkitt.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AmericanElegy/GenericScraperToolkitt/issues"
  },
  "homepage": "https://github.com/AmericanElegy/GenericScraperToolkitt#readme",
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.1-beta",
    "wrangler": "4.151.3"
  },
  "private": true,
  "dependencies": {
    "entities": "8.1.0"
  }
}
